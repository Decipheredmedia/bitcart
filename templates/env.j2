# Bitcart Docker environment file
# Generated by deploy_bitcart.py on {{ generated_at }}
# DO NOT EDIT MANUALLY — re-run deploy_bitcart.py configure to regenerate

BITCART_HOST={{ domain }}
BITCART_ADMIN_HOST={{ admin_domain }}
BITCART_STORE_HOST={{ store_domain }}
BITCART_LETSENCRYPT_HOST={{ domain }},{{ admin_domain }},{{ store_domain }}
BITCART_INSTALL=all
BITCART_CRYPTOS={{ cryptos | join(',') }}
BITCART_REVERSEPROXY=nginx
{% if tor_enable %}
BITCART_ADDITIONAL_COMPONENTS=tor
{% endif %}
BITCART_EMAIL={{ email }}

# Database
POSTGRES_PASSWORD={{ db_password }}
POSTGRES_DB=bitcartcc
POSTGRES_USER=postgres

# Lightning
{% if lightning_enable %}
BITCART_LIGHTNING=true
{% else %}
BITCART_LIGHTNING=false
{% endif %}

# Cryptos
{% for crypto in cryptos %}
{% if crypto == 'btc' %}
BTC_NETWORK=mainnet
{% endif %}
{% if crypto == 'ltc' %}
LTC_NETWORK=mainnet
{% endif %}
{% if crypto == 'eth' %}
ETH_NETWORK=mainnet
{% endif %}
{% endfor %}

# Security
BITCART_HTTPS_REDIRECT=true
